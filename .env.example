# Базавы адрас API. Swagger UI жыве на /api, самі метады — у корані гэтага хоста.
KNIZHNYVOZ_API_BASE=https://api.knizhnyvoz.com

# JWT з кукі аўтарызацыі або з POST /auth/login. Без токена даступны толькі апублікаваны каталог.
AUTH_COOKIE=
# Састарэлая назва таго ж JWT. Выкарыстоўваецца, калі AUTH_COOKIE пусты.
KNIZHNYVOZ_API_TOKEN=
